# Copy this file to `.env` (gitignored) and fill in the values.
# In dev, `.env` is loaded automatically at startup (see loadDevEnv in src/main.ts).
# Real shell env vars always win over `.env`.

# Spotify OAuth — used by the "Integrationen" settings tab.
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add the redirect URI EXACTLY: http://127.0.0.1:8888/callback
# 3. Paste the app's Client ID below.
SPOTIFY_CLIENT_ID=

# Optional — change the loopback port. Must match the redirect URI you registered.
# SPOTIFY_REDIRECT_PORT=8888
